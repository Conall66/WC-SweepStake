{
  "name": "worldcup-sweep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A matt-black PWA for a provably-fair 2026 World Cup sweepstake.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:tournament": "node scripts/fetch-tournament.mjs",
    "emulators": "firebase emulators:start --only auth,firestore,functions",
    "dev:firebase": "VITE_USE_FIREBASE=true VITE_USE_FIREBASE_EMULATOR=true vite",
    "test:rules": "vitest run src/data/firebaseRepository.test.ts"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "firebase": "^10.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/topojson-client": "^3.1.4",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.5",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7"
  }
}
