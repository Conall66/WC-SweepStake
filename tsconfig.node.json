{
  "compilerOptions": {
    "composite": true,
    // Emit the type-check artifacts into a throwaway dir so tsc does NOT drop a
    // vite.config.js next to vite.config.ts (Vite loads .js before .ts, so a
    // stale compiled copy would silently shadow the real config).
    "outDir": "./node_modules/.tmp",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts"]
}
